{
  "name": "@xelandernt/hrns-tui",
  "version": "0.0.0",
  "description": "Mount the hrns terminal in a browser application",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xelandernt/hrns.git",
    "directory": "rust/npm"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "wasm/*.js", "wasm/*.wasm"],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.package.json",
    "build:wrapper": "tsc"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
